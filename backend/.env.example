# ============================================================
#  Desk+ — BACKEND .env.example
#  Copy this to backend/.env and fill in the blanks.
#  NEVER commit your real .env (it's gitignored).
# ============================================================

APP_NAME="Desk+"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Database: Supabase PostgreSQL ────────────────────────────
# Get DB_URL from Supabase → Project Settings → Database → Connection string
# Use the "Session pooler" / "Transaction pooler" URI and append the password.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
PGSSLMODE=require

# ── Google OAuth (Sign in with Google) ───────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI must be exactly the GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Frontend URL (Vite dev server) ───────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Sanctum / Session ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

# ── Cache / Queue ────────────────────────────────────────────
# 'file' avoids needing the DB just to clear cache (recommended for local).
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Mail: Gmail SMTP (real emails) ───────────────────────────
# MAIL_USERNAME / MAIL_FROM_ADDRESS must be the SAME Gmail address.
# MAIL_PASSWORD = a Google "App Password" (16 chars, NO spaces) — requires 2FA on.
#   https://myaccount.google.com/apppasswords
# For testing without real emails, set MAIL_MAILER=log and read storage/logs/laravel.log
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Desk+"

# ── Filesystem ───────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Supabase (project URL — used by the app where needed) ────
SUPABASE_URL=https://PROJECT_REF.supabase.co
