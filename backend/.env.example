# ============================================================
# .env  —  LOCAL DEVELOPMENT  (MySQL via Laragon)
# Copy this to your backend/.env
# ============================================================

APP_NAME="Desk+"
APP_ENV=local
APP_KEY=                        # Run: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local MySQL (Laragon default)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deskplus
DB_USERNAME=root
DB_PASSWORD=

# Sanctum — allow React dev server
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

# CORS — React frontend
FRONTEND_URL=http://localhost:5173

# Cache / Queue (local = sync, no Redis needed)
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mail (use Mailtrap for local testing)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_pass
MAIL_FROM_ADDRESS=noreply@deskplus.ma
MAIL_FROM_NAME="Desk+"

# Filesystem (local storage for dev)
FILESYSTEM_DISK=public

# Supabase Storage (optional in dev — use local storage instead)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=


