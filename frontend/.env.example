# ============================================================
#  Desk+ — FRONTEND .env.example
#  Copy this to frontend/.env and fill in the blanks.
#  Vite only exposes vars prefixed with VITE_.
# ============================================================

# Supabase — used for product image uploads to Storage.
# Get these from Supabase → Project Settings → API:
#   VITE_SUPABASE_URL       = Project URL
#   VITE_SUPABASE_ANON_KEY  = Project API keys → "anon" "public"
#
# NOTE: the ANON (public) key is SAFE to expose in the browser — that's its
# purpose. NEVER put the service_role / secret key in the frontend.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: override the API base URL (defaults to http://localhost:8000/api)
# VITE_API_URL=http://localhost:8000/api
